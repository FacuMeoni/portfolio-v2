---
import Layout from '@/layouts/Layout.astro';

import About from '@/components/sections/About.astro';
import Education from '@/components/sections/Education.astro';
import Hero from '@/components/sections/Hero.astro';
import KeyboardManager from '@/components/KeyboardManager.astro';
import Projects from '@/components/sections/Projects.astro';
import Stack from '@/components/sections/Stack.astro';
import Work from '@/components/sections/Work.astro';

import cv from '@/data/cv.es.json';
import { useTranslations } from '@/i18n/utils';

const lang = 'es'
const t = useTranslations(lang)
---

<Layout title="Facundo Meoni | Portfolio" description={t('meta.description')} lang={lang}>
	<main>
		 <Hero basics={cv.basics} whatsappMessage={t('hero.whatsappMessage')} />
		 <About summary={cv.basics.summary} />
		 <Work work={cv.work} title={t('section.work')} />
		 <Projects projects={cv.projects} title={t('section.projects')} archivedLabel={t('projects.archived')} />
		 <Education education={cv.education} title={t('section.education')} />
		 <Stack stack={cv.stack} title={t('section.stack')} />
	</main>
	<KeyboardManager printHintPrefix={t('footer.printHintPrefix')} printHintSuffix={t('footer.printHintSuffix')} />
</Layout>

<style>
	main {
		padding: 40px 24px 80px;
        margin: auto;
        width: 100%;
	}

	@media (max-width: 640px) {
		main {
			padding: 56px 20px 80px;
		}
	}
</style>
