---
 const { title }  = Astro.props
---

<section>
    { title && <h2> { title }  </h2> }
    <slot />
</section>

<style>
    section {
        max-width: 672px;
        margin: 0 auto 40px;
    }

    h2 {
        margin-bottom: 20px;
        font-weight: 500;
        line-height: 1.4;
        font-size: 18px;
        letter-spacing: -0.01em;
        color: var(--text-primary);
    }
</style>