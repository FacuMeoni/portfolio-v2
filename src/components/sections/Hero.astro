---
import Section from '@/components/Section.astro'
import Mail from '@/icons/Mail.astro'
import Phone from '@/icons/Phone.astro'
import Github from '@/icons/Github.astro'
import LinkedIn from '@/icons/LinkedIn.astro'

interface Props {
  basics: {
    name: string;
    email: string;
    phone: string;
    profiles: { network: string; username: string; url: string }[];
  };
  whatsappMessage: string;
}

const { basics, whatsappMessage } = Astro.props
const { name, email, phone, profiles } = basics

const SOCIAL_ICONS ={ Github, LinkedIn }
const linkedInInfo = profiles.find(profile => profile.network === 'LinkedIn')
const whatsappNumber = `549${phone.replace(/\D/g, '').slice(2)}`
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`
---


<Section>
  <div class="container">
    <header class="print">
      <h1>{ name } </h1>
    </header>
    <header class="no-print">
      <div class="heading">
        <h1>{ name }</h1>
      </div>
      <nav>
        {
          email && (
            <a
            href={`mailto:${email}`}
            title={`Send an email to ${name} at ${email}`}
            target="_blank"
            rel="noopener noreferrer"
            >
              <Mail />
            </a>
          )
        }
        {
              phone && (
                  <a
                  href={whatsappUrl}
                  title={`Chat with ${name} on WhatsApp`}
                  target="_blank"
                  rel="noopener noreferrer"
                  >
                  <Phone />
                  </a>
              )
        }
        {
            profiles && profiles.map(profile => {
              const Icon = SOCIAL_ICONS[profile.network]

              return(
                <a
                href={profile.url}
                title={`Visit ${name} profile at ${profile.network}`}
                target="_blank"
                rel="noopener noreferrer"
                >
                  <Icon />
                </a>
              )
              })
        }
      </nav>
    </header>
    <div class="print contact">
        <span>
            <Mail /> { email }
        </span>
        <span>
            <Phone /> { phone }
        </span>
        <span>
            <LinkedIn /> { linkedInInfo?.url }
        </span>
    </div>
  </div>
</Section>

<style>
  .container {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .heading {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  h1 {
    font-size: 18px;
    font-weight: 500;
  }

  nav {
  display: flex;
  align-items: center;
  justify-content: end;
  gap: 14px;
  }

  nav a {
    display: flex;
    color: var(--text-primary);
    transition: color 0.15s ease;
    justify-content: center;
    align-items: center;
  }

  nav a:hover {
    color: var(--text-meta);
  }

  .contact {
    display: flex;
    flex-direction: column;
    flex-wrap: wrap;
    gap: 5px;
    margin: 10px 0;
  }

  .contact span {
    display: inline-flex;
    align-items: center;
    justify-content: start;
    gap: 5px;
    font-size: 12px;
  }
</style>
