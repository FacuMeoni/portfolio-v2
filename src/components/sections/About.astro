---
 import Section from "@/components/Section.astro";

import { basics } from '@/cv'
const { summary } = basics

---

<Section>
    <div class="paragraphs">
        { summary.split('\n\n').map(paragraph => <p>{ paragraph }</p>) }
    </div>
</Section>

<style>
    .paragraphs {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    p {
        font-size: 16px;
        line-height: 1.6;
    }
</style>
