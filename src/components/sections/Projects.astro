---
 import Section from "@/components/Section.astro";

 import { projects } from "@/cv"
 import Github from "@/icons/Github.astro";
 import ExternalLink from "@/icons/ExternalLink.astro";
---

<Section title="Projects">
  <ul>
    { projects.map(({name, isActive, description, url, github}) => (
      <li>
        <div class="info">
          <span class="name">{ name }</span>
          <span class="description">{ description }</span>
        </div>
        <div class="links">
          { github && (
            <a
              href={github}
              target="_blank"
              rel="noopener noreferrer"
              title={`See project ${name} on Github`}
              class="icon-link"
            > <Github/> </a>
          )}
          { url && (
            <a
              href={url}
              target="_blank"
              rel="noopener noreferrer"
              title={`Visit ${name}`}
              class="icon-link"
            > <ExternalLink/> </a>
          )}
        </div>
      </li>
    ))}
  </ul>
</Section>


<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }

  .info {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
    min-width: 0;
    font-size: 14px;
  }

  .name {
    flex-shrink: 0;
    font-weight: 600;
    color: var(--text-primary);
  }

  .description {
    color: var(--text-secondary);
  }

  .links {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    gap: 10px;
  }

  .archived {
    font-size: 14px;
    color: var(--text-meta);
  }

  .icon-link {
    display: flex;
    color: var(--text-primary);
    transition: color 0.15s ease;
  }

  .icon-link:hover {
    color: var(--text-meta);
  }
</style>
