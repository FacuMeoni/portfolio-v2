---
interface Props {
	title: string;
	description: string;
	lang: string;
}

const { title, description, lang } = Astro.props;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image.webp" href="/facu-logo.webp" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
<style is:global>
	:root {
		--bg: #ffffff;
		--bg-subtle: #f4f4f5;
		--text-primary: #000000;
		--text-secondary: #52525b;
		--text-meta: #71717a;
		--text-muted: #a1a1aa;
		--border: #e4e4e7;
		--accent: #000000;
		--accent-hover: #3f3f46;
		--accent-soft: #f4f4f5;
	}

	html {
		font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
		background-color: var(--bg);
	}

	body,
	figure {
		padding: 0;
		margin: 0;
	}

	a {
		text-decoration: none;
	}

	ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	*, *::before, *::after {
		box-sizing: border-box;
	}

	h1, h2, h3, h4 {
		font-family: inherit;
		margin: 0;
		color: var(--text-primary);
		font-size: 16px;
		font-weight: 500;
		letter-spacing: -0.01em;
	}

	p {
		color: var(--text-secondary);
		font-size: 16px;
		margin: 0;
		line-height: 1.6;
		text-wrap: pretty;
	}

	span {
		font-size: 14px;
		margin: 0;
	}

	@media print {
		.no-print {
			display: none !important;
		}
		html {
			background-color: #fff;
		}
		p {
			color: #333;
			orphans: 3;
			widows: 3;
		}
		h1, h2, h3, h4 {
			color: #000;
		}
		/* Ocultar fecha y hora en la impresión */
		@page {
			margin: 0.5in;
		}
		/* Ocultar encabezados y pies de página del navegador */
		@page :first {
			margin-top: 0.5in;
		}
		@page :left {
			margin-left: 0.5in;
		}
		@page :right {
			margin-right: 0.5in;
		}
	}

	.print {
		display: none !important;
	}

	@media print {
		.print{
			display: block !important;
		}
		/* Ocultar cualquier elemento de fecha/hora que el navegador pueda agregar */
		body::before,
		body::after {
			display: none !important;
		}
	}
</style>
